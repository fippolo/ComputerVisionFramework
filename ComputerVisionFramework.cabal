cabal-version:      3.0
name:               ComputerVisionFramework
version:            0.1.0.0
-- synopsis:
-- description:
license:            GPL-3.0-only
license-file:       LICENSE
author:             fippolo
maintainer:         filippo.fanesi@gmail.com
-- copyright:
category:           Graphics
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  ComputerVisionFW
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.20.2.0,
        array ^>=0.5.8.0,
        matrix >=0.3.4.4 && <0.4,
        random >=1.2 && <1.4,
        JuicyPixels >=3.3 && <3.4

    hs-source-dirs:   src
    default-language: Haskell2010

test-suite tests
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    default-language: Haskell2010
    build-depends:
        base,
        ComputerVisionFramework,
        HUnit,
        matrix
